<?xml version="1.0" encoding="utf-8"?>
<!-- OnePieceSkin's top-bar pills over the dark sea: parchment with a wooden rim at rest, so each icon sits on its own
     disc instead of a bare outline, and sun gold with a white rim when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFCD00" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF6B3F1D" />
            <stroke android:width="2dp" android:color="#FFFFCD00" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF3E0B0" />
            <stroke android:width="2dp" android:color="#FF6B3F1D" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
